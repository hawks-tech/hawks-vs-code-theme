          "string.special": { "color": "#FF79C6" },
          "string.special.symbol": { "color": "#BD93F9" },
          "tag": { "color": "#FF79C6" },
          "tag.attribute": { "color": "#50FA7B" },
          "text.literal": { "color": "#50FA7B" },
          "title": { "color": "#BD93F9", "font_weight": 700 },
